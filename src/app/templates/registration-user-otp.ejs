
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f5f5f5;">
    <div style="max-width: 500px; margin: 40px auto; background: #ffffff; padding: 30px; text-align: center; border-radius: 8px;">
        
        <h2 style="margin-bottom: 20px;">Email verification request</h2>

        <p style="color: #555;">
            Hello <%= name %>, we received a request to verify your email for <%= email %>.
        </p>
        <p style="color: #555;">
            Use the OTP below to verify your email.
        </p>

        <div style="font-size: 32px; font-weight: bold; letter-spacing: 8px; margin: 25px 0;">
            <%= otp %>
        </div>

        <p style="font-size: 13px; color: #888;">
            This OTP is expire in <%= expirationMinutes %> minutes. If you didn't request this, please ignore this email.
        </p>

    </div>
</body>
</html>